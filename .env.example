# ── Supabase (projeto de DEV; não use produção) ──────────────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — NUNCA vai ao browser>

# Conexão direta ao Postgres do Supabase (Settings → Database → Connection string
# → URI). Usada pelo scripts/e2e.sh para migrações, seed e verificação.
# postgres://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# E-mail de um usuário de teste já criado no Supabase (Auth → Users → Add user).
# O e2e.sh preenche o perfil desse tenant e dispara o onboarding.
TEST_EMAIL=teste@exemplo.com

# ── Segredos dos serviços internos (gere valores fortes) ─────────────────────
PORTAL_RUNNER_TOKEN=troque-por-um-segredo-forte
RANK_SERVICE_TOKEN=troque-por-outro-segredo-forte

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=<chave OpenRouter — ranking>
RANK_MODEL=anthropic/claude-3.5-haiku
OPENAI_API_KEY=<chave OpenAI — embeddings>
EMBED_MODEL=text-embedding-3-small

# ── Notificação (opcional no teste) ──────────────────────────────────────────
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_MIN_SCORE=60
NOTIFY_TOP=5
PANEL_URL=http://localhost:3000/vagas
