# Porta do serviço HTTP.
PORT=8080

# Segredo compartilhado com o n8n. Os endpoints POST exigem
# Authorization: Bearer <este valor>. Sem ele, os POST respondem 503 (fail closed).
PORTAL_RUNNER_TOKEN=troque-por-um-segredo-forte

# Tempo máximo por execução de CLI (ms).
PORTAL_RUNNER_TIMEOUT_MS=30000

# Kill-switch por portal, separado por vírgula. Ex.: "catho,vagas" desliga os dois.
# Vazio = todos habilitados. (O n8n também checa feature_flags no banco antes de chamar.)
PORTAL_RUNNER_DISABLED=
