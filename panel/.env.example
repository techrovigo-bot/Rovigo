# Supabase — expostos ao browser (anon key é pública por design; RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# URL do webhook do n8n (onboarding-hook). Só no servidor.
N8N_ONBOARDING_URL=https://<n8n-host>/webhook/onboarding

# Base URL do painel (para o redirect do magic link e do checkout).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (billing) — tudo SÓ no servidor ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # endpoint: {SITE}/api/stripe/webhook
STRIPE_PRICE_ALERTAS=price_...         # price id (recorrente mensal, BRL) do tier Alertas

# service_role key — usada SÓ pelo webhook do Stripe (server-only, nunca no browser).
SUPABASE_SERVICE_KEY=<service_role key>
